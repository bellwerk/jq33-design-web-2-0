# Public build-time integration values. These are substituted into the static
# artifact; no runtime config file or backend credential is generated.
PUBLIC_FORMSPREE_CONTACT_URL=
PUBLIC_FORMSPREE_INQUIRY_URL=
PUBLIC_CALENDLY_URL=

# Optional, user-confirmed public social profiles. Leave an unconfirmed profile
# empty so no link is emitted.
PUBLIC_SOCIAL_INSTAGRAM_URL=
PUBLIC_SOCIAL_FACEBOOK_URL=
PUBLIC_SOCIAL_YOUTUBE_URL=
PUBLIC_SOCIAL_BEHANCE_URL=

# The verification-only GitHub workflow receives the three required public
# integration values as repository secrets. Cloudflare Pages remains the only
# deployment path and injects Web Analytics automatically.
